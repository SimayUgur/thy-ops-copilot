{
  "type": "function",
  "function": {
    "name": "cache_lookup",
    "description": "Onbellekten (onayli/seed etiketli) mevcut SQL planini ve ornek satirlarini dondurur; hizli cevap icin.",
    "parameters": {
      "properties": {
        "question": {
          "description": "Userin doğal dilde sorusu.",
          "title": "Question",
          "type": "string"
        },
        "top_k": {
          "default": 8,
          "description": "Cache içerisinde bakilacak maksimum aday sayisi.",
          "maximum": 50,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "threshold": {
          "default": 0.85,
          "description": "Cache eşik skoru.",
          "maximum": 1,
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "preview_rows": {
          "default": 100,
          "description": "Onizleme olarak dondurulecek satir adedi.",
          "maximum": 2000,
          "minimum": 1,
          "title": "Preview Rows",
          "type": "integer"
        },
        "return_rows": {
          "default": true,
          "description": "Satir onizlemesini döndür.",
          "title": "Return Rows",
          "type": "boolean"
        },
        "return_chart": {
          "default": false,
          "description": "Grafik spec /olursa) dondur.",
          "title": "Return Chart",
          "type": "boolean"
        },
        "prefer_tag": {
          "default": "approved|seed",
          "description": "Tag filtre (orn. approved|seed).",
          "title": "Prefer Tag",
          "type": "string"
        },
        "cache_only": {
          "default": true,
          "description": "True ise cache miss olursa graph'a dusme.",
          "title": "Cache Only",
          "type": "boolean"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "İstemci oturum ID (izleme icin).",
          "title": "Session Id"
        }
      },
      "required": [
        "question"
      ],
      "title": "CacheLookupParams",
      "type": "object"
    }
  }
}